generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector] // Declare the use of pgvector
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String?
  password String?
  image    String?
  role     String  @default("USER") // USER or ADMIN

  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime?          @updatedAt
  ratings            Rating[]
  comments           Comment[]
  readingLists       ReadingList[]
  mangaHistories     MangaHistory[]
  animeRatings       AnimeRating[]
  watchLists         WatchList[]
  animeHistories     AnimeHistory[]
  aiChatSessions     AiChatSession[]
  createdCommunities Community[]        @relation("CommunityCreator")
  joinedCommunities  Community[]        @relation("CommunityMembers")
  forumPosts         ForumPost[]
  forumVotes         ForumVote[]
  forumComments      ForumComment[]
  forumCommentVotes  ForumCommentVote[]

  hostedRooms      PartyRoom[]     @relation("HostRooms")
  joinedRooms      RoomMember[]    @relation("MemberRooms")
  hostedMangaRooms MangaCoRoom[]   @relation("MangaRoomHost")
  mangaRoomMembers MangaCoMember[]
}

model Anime {
  id             String         @id @default(uuid())
  title          String
  description    String?        @db.Text
  coverImage     String?
  episodes       Episode[]
  createdAt      DateTime       @default(now())
  ratings        AnimeRating[]
  watchListedBy  WatchList[]
  comments       Comment[]
  animeHistories AnimeHistory[]
  fandomPrefix   String         @default("") // e.g., "jujutsu-kaisen", "naruto"

  partyRooms    PartyRoom[]
  animeViewLogs AnimeViewLog[]
}

model Manga {
  id          String  @id @default(uuid())
  title       String  @unique // Add @unique to find manga by title without duplicates
  description String? @db.Text
  author      String?
  coverImage  String?
  status      String  @default("ONGOING")

  // A manga series with many chapters
  chapters Chapter[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  ratings        Rating[]
  comments       Comment[]
  readingLists   ReadingList[]
  mangaHistories MangaHistory[]
  fandomPrefix   String         @default("")
  mangaViewLogs  MangaViewLog[]
  mangaCoRooms   MangaCoRoom[]
}

model Episode {
  id               String                       @id @default(uuid())
  title            String // e.g., "Episode 01", "Episode 02"
  videoUrl         String // Path to video from Cloudinary
  animeId          String
  anime            Anime                        @relation(fields: [animeId], references: [id], onDelete: Cascade)
  subtitles        Subtitle[] // A episode can have multiple subtitles (Vietnamese, English, Japanese...)
  createdAt        DateTime                     @default(now())
  comments         Comment[]
  animeHistories   AnimeHistory[]
  mappedChapterIds String[]                     @default([])
  episodeNumber    Int?
  dubbedLanguages  String[]                     @default([])
  plotSummary      String?                      @db.Text // Content summary (Use @db.Text to store long text)
  characters       String[]                     @default([]) // Array containing list of characters appearing
  adaptedFrom      String? // Store information about adaptation from which chapter (e.g., "Chapters 1-2")
  embedding        Unsupported("vector(3072)")?

  partyRooms PartyRoom[]
}

model Subtitle {
  id        String  @id @default(uuid())
  label     String // Display label, e.g., "Vietnamese", "English"
  url       String // Path to .srt or .ass file from Cloudinary
  episodeId String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model Chapter {
  id     String   @id @default(uuid())
  title  String // Chapter name (e.g., Chapter 1)
  images String[] // Store list of Cloudinary image links as an array

  // Foreign key linking to the Manga table
  mangaId String
  manga   Manga  @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  chapterNumber Float? // Use Float to accommodate chapters like 1.5, 10.1...
  characters    String[] // Array containing names of characters
  plotSummary   String? // Content summary
  embedding     Unsupported("vector(3072)")?

  createdAt      DateTime       @default(now())
  comments       Comment[]
  mangaHistories MangaHistory[]
  mangaCoRooms   MangaCoRoom[]
}

model Rating {
  id    String @id @default(uuid())
  score Int // Points from 1 to 5

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mangaId String
  manga   Manga  @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Ensure 1 user only rates 1 manga once
  @@unique([userId, mangaId])
}

// Comment table (Used for both Manga and Chapters)
model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // -- For MANGA --
  mangaId   String?
  manga     Manga?   @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  // -- For ANIME  --
  animeId   String?
  anime     Anime?   @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model ReadingList {
  id String @id @default(uuid())

  // Foreign key linking to the User table
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Foreign key linking to the Manga table
  mangaId String
  manga   Manga  @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Constraint: A user may add a given series to their list only once.
  @@unique([userId, mangaId])
}

// Reading History Table
model MangaHistory {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mangaId String
  manga   Manga  @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  // Save the exact chapter that the user is currently reading.
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  // updatedAt is very important to sort history from newest to oldest
  updatedAt DateTime @default(now()) @updatedAt

  // Ensure 1 user only has 1 history record for 1 manga (overwrite when reading new chapter)
  @@unique([userId, mangaId])
}

// Star Rating for Anime (1-5 points)
model AnimeRating {
  id        String   @id @default(uuid())
  score     Int // Points from 1 to 5
  createdAt DateTime @default(now())

  userId  String
  animeId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  // Ensure that each user can rate a given movie only once.
  @@unique([userId, animeId])
}

// Watchlist
model WatchList {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId  String
  animeId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  // Ensure that a user cannot add the same anime to their watchlist multiple times
  @@unique([userId, animeId])
}

model AnimeHistory {
  id        String   @id @default(uuid())
  updatedAt DateTime @default(now()) @updatedAt
  userId    String
  animeId   String
  episodeId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime   Anime   @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId]) // Ensure each episode is only recorded once per user
}

model TranslationCache {
  id         String   @id @default(uuid())
  imageUrl   String // Link to original image
  targetLang String // Target language (Vietnamese, English...)
  blocks     Json // Store the entire JSON array of coordinates and text
  createdAt  DateTime @default(now())

  // Create a unique composite key: Ensure that 1 image + 1 language only saves 1 row
  @@unique([imageUrl, targetLang])
}

model AiChatSession {
  id        String          @id @default(uuid())
  title     String // Chat session name (Automatically derived from the first question)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiChatMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// A table storing individual messages within a chat session
model AiChatMessage {
  id        String        @id @default(uuid())
  sessionId String
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // Accepts only 2 values: "user" or "model"
  content   String        @db.Text
  createdAt DateTime      @default(now())
}

// 1. System's core modules
enum PostCategory {
  ANIME
  MANGA
  GENERAL
}

// 2. Community Groups (Sub-forum)
model Community {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @db.Text
  coverImage  String? // Group cover image
  createdAt   DateTime @default(now())

  // Group creator (Admin)
  creatorId String
  creator   User   @relation("CommunityCreator", fields: [creatorId], references: [id])

  // List of members
  members User[] @relation("CommunityMembers")

  // List of posts within the group
  posts ForumPost[]
}

// 3. Main Forum Posts (User-generated content)
model ForumPost {
  id            String       @id @default(uuid())
  title         String
  content       String       @db.Text
  mediaUrl      String?
  category      PostCategory @default(GENERAL) // Lọc theo Anime/Manga
  tags          String[] // Mảng các tag tự do (VD: #Review, #Spoiler)
  isSpoiler     Boolean      @default(false) // Cờ đánh dấu spoiler
  upvoteCount   Int          @default(0)
  downvoteCount Int          @default(0)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  forumVotes    ForumVote[]
  forumComments ForumComment[]
}

// 4. Voting system for posts and comments in forum (Upvote/Downvote)
enum VoteType {
  UP
  DOWN
}

model ForumVote {
  id     String    @id @default(uuid())
  type   VoteType
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Ensure that each user can vote only once per post.
  @@unique([userId, postId])
}

model ForumComment {
  id          String @id @default(uuid())
  content     String @db.Text
  upvoteCount Int    @default(0) // 🌟 Comment vote score

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // 🌟 SUPPORT FOR NESTED REPLIES (MULTI-LEVEL REPLIES)
  parentId String?
  parent   ForumComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ForumComment[] @relation("CommentReplies")

  votes ForumCommentVote[] // Link to the voting table

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// 🌟 NEW TABLE: Comment Vote Management
model ForumCommentVote {
  id        String       @id @default(uuid())
  type      VoteType // Vẫn dùng enum VoteType (UP/DOWN) đã tạo trước đó
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   ForumComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId]) // Each user can vote only once per comment.
}

// 🌟 Thêm Model này vào schema.prisma
model Notification {
  id        String   @id @default(uuid())
  userId    String
  // user      User     @relation(fields: [userId], references: [id]) 
  title     String // e.g., "New chapter is released!"
  message   String // e.g., "Jujutsu Kaisen has been updated Chapter 236"
  linkUrl   String // Click the link to go straight to the new chapter or episode
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ==========================================
// 🍿 TÍNH NĂNG WATCH PARTY (XEM CHUNG)
// ==========================================

model PartyRoom {
  id         String  @id @default(uuid())
  name       String // Room name 
  inviteCode String  @unique // Invite code (6 characters) for sharing links (e.g., "X7K9P2")
  isPrivate  Boolean @default(false) // true: Requires approval, false: Anyone can join
  status     String  @default("ACTIVE") // Status: "ACTIVE" (Open), "CLOSED" (Closed)

  hostId    String // Room host
  animeId   String? // Anime being watched (allows null when creating room)
  episodeId String? // Tập đang chiếu

  themeConfig Json? @default("{\"accent\":\"#3b82f6\",\"glow\":\"rgba(59,130,246,0.5)\",\"bgUrl\":\"\"}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  host    User         @relation("HostRooms", fields: [hostId], references: [id], onDelete: Cascade)
  anime   Anime?       @relation(fields: [animeId], references: [id], onDelete: SetNull)
  episode Episode?     @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  members RoomMember[]
}

model RoomMember {
  id       String   @id @default(uuid())
  roomId   String
  userId   String
  status   String   @default("PENDING") // Status: "PENDING", "JOINED", "BANNED" 
  joinedAt DateTime @default(now())

  // Relationships
  room PartyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User      @relation("MemberRooms", fields: [userId], references: [id], onDelete: Cascade)

  // 🌟 Constraint: A user can have only one status record within a single room.
  @@unique([roomId, userId])
}

model AnimeViewLog {
  id        String   @id @default(uuid())
  animeId   String
  createdAt DateTime @default(now())

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@index([animeId])
  @@index([createdAt]) // Create an index to enable ultra-fast queries by day/week/month
}

model MangaViewLog {
  id        String   @id @default(uuid())
  mangaId   String
  createdAt DateTime @default(now())

  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@index([mangaId])
  @@index([createdAt])
}

model MangaCoRoom {
  id            String   @id @default(cuid())
  name          String
  inviteCode    String   @unique
  isPrivate     Boolean  @default(false)
  mangaId       String?
  chapterId     String?
  currentPage   Int      @default(0)
  scrollPercent Float    @default(0)
  isHostLocked  Boolean  @default(true)
  hostId        String
  host          User     @relation("MangaRoomHost", fields: [hostId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  manga         Manga?   @relation(fields: [mangaId], references: [id], onDelete: SetNull)
  chapter       Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  members MangaCoMember[]
}

model MangaCoMember {
  id       String      @id @default(cuid())
  roomId   String
  userId   String
  status   String      @default("JOINED") // "JOINED" | "PENDING" | "REJECTED" | "BANNED"
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  room     MangaCoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  joinedAt DateTime    @default(now())

  @@unique([roomId, userId])
}
