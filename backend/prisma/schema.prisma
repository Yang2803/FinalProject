generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector] // Khai báo dùng pgvector
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String?
  password String?
  role     String  @default("USER") // USER hoặc ADMIN

  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime?          @updatedAt
  ratings           Rating[]
  comments          Comment[]
  readingLists      ReadingList[]
  mangaHistories    MangaHistory[]
  animeRatings      AnimeRating[]
  watchLists        WatchList[]
  animeHistories    AnimeHistory[]
  aiChatSessions    AiChatSession[]
  createdCommunities Community[] @relation("CommunityCreator")
  joinedCommunities  Community[] @relation("CommunityMembers")
  forumPosts        ForumPost[]
  forumVotes        ForumVote[]
  forumComments     ForumComment[]
  forumCommentVotes ForumCommentVote[]
}

model Anime {
  id             String         @id @default(uuid())
  title          String
  description    String?        @db.Text
  coverImage     String?
  episodes       Episode[]
  createdAt      DateTime       @default(now())
  ratings        AnimeRating[]
  watchListedBy  WatchList[]
  comments       Comment[]
  animeHistories AnimeHistory[]
  fandomPrefix   String         @default("") // Ví dụ: "jujutsu-kaisen", "naruto"
}

model Manga {
  id          String  @id @default(uuid())
  title       String  @unique // Thêm @unique để tìm truyện theo tên không bị trùng
  description String? @db.Text
  author      String?
  coverImage  String?
  status      String  @default("ONGOING")

  // Mối quan hệ 1 Manga có nhiều Chapter
  chapters Chapter[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  ratings        Rating[]
  comments       Comment[]
  readingLists   ReadingList[]
  mangaHistories MangaHistory[]
  fandomPrefix   String         @default("")
}

model Episode {
  id               String                       @id @default(uuid())
  title            String // Ví dụ: "Tập 01", "Tập 02"
  videoUrl         String // Đường dẫn video từ Cloudinary
  animeId          String
  anime            Anime                        @relation(fields: [animeId], references: [id], onDelete: Cascade)
  subtitles        Subtitle[] // Một tập phim có thể có nhiều phụ đề (Việt, Anh, Nhật...)
  createdAt        DateTime                     @default(now())
  comments         Comment[]
  animeHistories   AnimeHistory[]
  mappedChapterIds String[]                     @default([])
  episodeNumber    Int?
  dubbedLanguages  String[]                     @default([])
  plotSummary      String?                      @db.Text // Nội dung cốt truyện (Dùng @db.Text để lưu văn bản dài)
  characters       String[]                     @default([]) // Mảng chứa danh sách tên nhân vật xuất hiện
  adaptedFrom      String? // Lưu thông tin chuyển thể từ chapter nào (Ví dụ: "Chapters 1-2")
  embedding        Unsupported("vector(3072)")?
}

model Subtitle {
  id        String  @id @default(uuid())
  label     String // Nhãn hiển thị, ví dụ: "Tiếng Việt", "English"
  url       String // Đường dẫn file .srt hoặc .ass từ Cloudinary
  episodeId String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model Chapter {
  id     String   @id @default(uuid())
  title  String // Tên chương (VD: Chapter 1)
  images String[] // Lưu danh sách link ảnh Cloudinary dưới dạng mảng

  // Khóa ngoại liên kết với bảng Manga
  mangaId String
  manga   Manga  @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  chapterNumber Float? // Dùng Float để phòng hờ có Chapter 1.5, 10.1...
  characters    String[] // Mảng chứa tên nhân vật
  plotSummary   String? // Nội dung tóm tắt
  embedding     Unsupported("vector(3072)")?

  createdAt      DateTime       @default(now())
  comments       Comment[]
  mangaHistories MangaHistory[]
}

// Bảng lưu điểm đánh giá truyện
model Rating {
  id    String @id @default(uuid())
  score Int // Điểm từ 1 đến 5

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mangaId String
  manga   Manga  @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Đảm bảo 1 user chỉ được đánh giá 1 truyện 1 lần duy nhất
  @@unique([userId, mangaId])
}

// Bảng lưu bình luận (Dùng chung cho cả Manga và Chapter)
model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // -- DÀNH CHO MANGA (Đã có sẵn, bạn giữ nguyên) --
  mangaId   String?
  manga     Manga?   @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  // -- DÀNH CHO ANIME (Bạn THÊM phần này vào) --
  animeId   String?
  anime     Anime?   @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model ReadingList {
  id String @id @default(uuid())

  // Liên kết với bảng User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Liên kết với bảng Manga
  mangaId String
  manga   Manga  @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Ràng buộc: Một người dùng chỉ được thêm một bộ truyện vào danh sách một lần duy nhất
  @@unique([userId, mangaId])
}

// Bảng lưu lịch sử đọc Truyện
model MangaHistory {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mangaId String
  manga   Manga  @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  // Lưu lại đúng cái Chapter mà user đang đọc dở
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  // updatedAt rất quan trọng để sắp xếp lịch sử từ mới nhất đến cũ nhất
  updatedAt DateTime @default(now()) @updatedAt

  // Đảm bảo 1 user chỉ có 1 bản ghi lịch sử cho 1 bộ truyện (ghi đè khi đọc chap mới)
  @@unique([userId, mangaId])
}

// Bảng lưu điểm Đánh giá Sao của Anime
model AnimeRating {
  id        String   @id @default(uuid())
  score     Int // Điểm từ 1 đến 5
  createdAt DateTime @default(now())

  userId  String
  animeId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  // RẤT QUAN TRỌNG: Đảm bảo 1 user chỉ được đánh giá 1 lần cho 1 bộ phim
  @@unique([userId, animeId])
}

// Bảng lưu Danh sách xem (Watchlist)
model WatchList {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId  String
  animeId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  // Đảm bảo không bị thêm trùng 1 phim nhiều lần vào danh sách
  @@unique([userId, animeId])
}

model AnimeHistory {
  id        String   @id @default(uuid())
  updatedAt DateTime @default(now()) @updatedAt
  userId    String
  animeId   String
  episodeId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime   Anime   @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId]) // Đảm bảo mỗi tập phim chỉ ghi nhận 1 lần cập nhật
}

model TranslationCache {
  id         String   @id @default(uuid())
  imageUrl   String // Link ảnh gốc
  targetLang String // Ngôn ngữ đích (Vietnamese, English...)
  blocks     Json // Lưu trữ toàn bộ mảng JSON tọa độ và chữ
  createdAt  DateTime @default(now())

  // Tạo khóa Unique kép: Đảm bảo 1 ảnh + 1 ngôn ngữ chỉ lưu đúng 1 dòng
  @@unique([imageUrl, targetLang])
}

model AiChatSession {
  id        String          @id @default(uuid())
  title     String // Tên phiên chat (Tự động lấy từ câu hỏi đầu tiên)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiChatMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// Bảng lưu từng tin nhắn trong phiên chat
model AiChatMessage {
  id        String        @id @default(uuid())
  sessionId String
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // Chỉ nhận 2 giá trị: "user" hoặc "model"
  content   String        @db.Text
  createdAt DateTime      @default(now())
}

// 1. Chuyên mục cứng của hệ thống
enum PostCategory {
  ANIME
  MANGA
  GENERAL
}

// 2. Bảng Nhóm cộng đồng (Sub-forum)
model Community {
  id          String      @id @default(uuid())
  name        String      @unique
  description String      @db.Text
  coverImage  String?     // Ảnh bìa của nhóm
  createdAt   DateTime    @default(now())

  // Người tạo nhóm (Admin)
  creatorId   String
  creator     User        @relation("CommunityCreator", fields: [creatorId], references: [id])

  // Danh sách thành viên tham gia
  members     User[]      @relation("CommunityMembers")
  
  // Danh sách bài viết trong nhóm
  posts       ForumPost[]
}

// 3. Bảng Bài viết chính
model ForumPost {
  id          String       @id @default(uuid())
  title       String
  content     String       @db.Text
  mediaUrl    String?
  category    PostCategory @default(GENERAL) // Lọc theo Anime/Manga
  tags        String[] // Mảng các tag tự do (VD: #Review, #Spoiler)
  isSpoiler   Boolean      @default(false) // Cờ đánh dấu spoiler
  upvoteCount Int          @default(0)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  forumVotes    ForumVote[]
  forumComments ForumComment[]
}

// Thêm 2 bảng mới này vào cuối file
enum VoteType {
  UP
  DOWN
}

model ForumVote {
  id     String    @id @default(uuid())
  type   VoteType
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Đảm bảo mỗi user chỉ được vote 1 lần cho 1 bài viết
  @@unique([userId, postId])
}

model ForumComment {
  id          String @id @default(uuid())
  content     String @db.Text
  upvoteCount Int    @default(0) // 🌟 Điểm vote của comment

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // 🌟 HỖ TRỢ TRẢ LỜI CHÉO (REPLY ĐA CẤP)
  parentId String?
  parent   ForumComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ForumComment[] @relation("CommentReplies")

  votes ForumCommentVote[] // Liên kết tới bảng vote

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

// 🌟 BẢNG MỚI: Quản lý Vote của Comment
model ForumCommentVote {
  id        String       @id @default(uuid())
  type      VoteType // Vẫn dùng enum VoteType (UP/DOWN) đã tạo trước đó
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   ForumComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId]) // Mỗi user chỉ vote 1 lần cho 1 comment
}

// 🌟 Thêm Model này vào schema.prisma
model Notification {
  id        String   @id @default(uuid())
  userId    String
  // user      User     @relation(fields: [userId], references: [id]) // Bỏ comment nếu cậu có model User
  title     String   // VD: "Chương mới ra lò!"
  message   String   // VD: "Jujutsu Kaisen vừa cập nhật Chapter 236"
  linkUrl   String   // Link để click vào bay thẳng đến truyện
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

