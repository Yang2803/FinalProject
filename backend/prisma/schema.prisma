generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String?
  role      String   @default("USER") // USER hoặc ADMIN

  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
}

model Anime {
  id          String    @id @default(uuid())
  title       String
  description String?
  episodes    Episode[]
}

model Manga {
  id          String    @id @default(uuid())
  title       String    @unique // Thêm @unique để tìm truyện theo tên không bị trùng
  description String?   @db.Text
  author      String?  
  coverImage  String?  
  status      String    @default("ONGOING")
  
  // Mối quan hệ 1 Manga có nhiều Chapter
  chapters    Chapter[] 

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Episode {
  id       String            @id @default(uuid())
  title    String
  animeId  String
  anime    Anime             @relation(fields: [animeId], references: [id])
  mappings TimelineMapping[]
}

model Chapter {
  id          String   @id @default(uuid())
  title       String   // Tên chương (VD: Chapter 1)
  images      String[] // Lưu danh sách link ảnh Cloudinary dưới dạng mảng
  
  // Khóa ngoại liên kết với bảng Manga
  mangaId     String
  manga       Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  mappings    TimelineMapping[]

  createdAt   DateTime @default(now())
}

// Tính năng Anime-Manga Synchronization (Crowdsourcing)
model TimelineMapping {
  id        String   @id @default(uuid())
  episodeId String
  chapterId String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  
  episode   Episode  @relation(fields: [episodeId], references: [id])
  chapter   Chapter  @relation(fields: [chapterId], references: [id])
}